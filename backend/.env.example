# UniAttend FastAPI Server Configuration
APP_NAME=UniAttend-Backend
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Google Cloud & Firebase Configuration
FIREBASE_PROJECT_ID=gen-lang-client-0312401566
FIRESTORE_DATABASE_ID=ai-studio-uniattendunivers-c5e1918d-4a9e-4935-a356-3195f6c33ea5
# Path to service account JSON file. In Cloud Run, omit to use Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ais-dev-kvm6acr6maa3vhtzbttuqb-105903981961.asia-east1.run.app

# University Statutory Attendance Parameters
LATE_THRESHOLD_MINUTES=20
EXAM_ELIGIBILITY_PERCENTAGE=60.0
THREE_LATE_PENALTY_ENABLED=true
FACE_SIMILARITY_THRESHOLD=0.78

# Outbound SMTP Mail Dispatch Gateway
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mbstu.ac.bd

# IoT Hardware Device Master API Key
HARDWARE_SECRET_KEY=mbstu-hardware-secret-2026
