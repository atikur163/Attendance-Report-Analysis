# UniAttend System Environment Variables Example
FLASK_ENV=production
SECRET_KEY=generate_a_secure_random_string_for_production

# Local MySQL Configuration (User: root, Password: 1234)
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=uniattend_db

# Complete Database URI (SQLAlchemy format with PyMySQL)
DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/uniattend_db?charset=utf8mb4

# University Policy Configuration
LATE_THRESHOLD_MINUTES=20
EXAM_ELIGIBILITY_PERCENTAGE=60.0
THREE_LATE_PENALTY_ENABLED=True
TEACHER_REMINDER_TIMING=15_MIN_BEFORE
FACE_SIMILARITY_THRESHOLD=0.72
